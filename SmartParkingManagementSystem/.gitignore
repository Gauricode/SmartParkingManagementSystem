# .gitignore for SmartParkingManagementSystem
# Ignore Python virtual environments, caches and secrets

# Backend
backend/venv/
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/.env

# Frontend
frontend/.env
frontend/node_modules/
frontend/dist/

# IDE/editor
.vscode/
.idea/

# Do NOT ignore the entire project directory with a single '*'
